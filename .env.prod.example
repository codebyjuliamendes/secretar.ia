# Variáveis do docker-compose.prod.yml (a raiz). O resto do backend fica em backend/.env.
# Copie para .env no servidor e preencha. Nunca versione o .env preenchido.

# Domínios já apontados para o IP do servidor
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br
EVOLUTION_DOMAIN=wa.seudominio.com.br

# Banco (o Postgres não é exposto para fora do compose)
POSTGRES_USER=secretaria
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=secretaria

# Conexão com o WhatsApp: a MESMA chave precisa estar em backend/.env como EVOLUTION_API_KEY
EVOLUTION_API_KEY=troque-por-uma-chave-longa
