# Configurações do Banco de Dados PostgreSQL (Ex: Railway, Neon ou Docker local)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Configurações da API FastAPI
PORT=8000
HOST="0.0.0.0"

# Segurança e Integrações
CRON_SECRET="insira-um-token-seguro-aqui"
SAAS_API_KEY="insira-sua-api-key-do-sistema-aqui"

# Criptografia Webhook WhatsApp (Meta)
WHATSAPP_APP_SECRET="insira-seu-segredo-de-aplicativo-meta-aqui"
