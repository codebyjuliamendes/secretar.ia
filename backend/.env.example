# ------------------------------------------------------------------
# Ambiente: development | staging | production
# Em production/staging, JWT_SECRET, WHATSAPP_APP_SECRET e CRON_SECRET
# sao obrigatorios e a aplicacao se recusa a iniciar sem eles.
# ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Banco de dados PostgreSQL (Docker local, Neon, Railway, Supabase...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secretaria?schema=public"

# Origens permitidas no CORS (separadas por virgula). Nunca use * com credenciais.
CORS_ORIGINS="http://localhost:4000"

# URL publica do frontend (usada nos links de e-mail)
FRONTEND_URL="http://localhost:4000"
# URL publica desta API (redirect do OAuth Google, webhook da Evolution, push do Google Calendar). Em producao, https.
PUBLIC_API_URL="http://localhost:8000"

# Autenticacao (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Webhook WhatsApp normalizado (assinatura HMAC SHA-256 no header X-Hub-Signature-256)
WHATSAPP_APP_SECRET="segredo-compartilhado-com-quem-envia-o-webhook"

# Evolution API (envio de mensagens, QR Code e webhook nativo)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_WEBHOOK_TOKEN="token-aleatorio-usado-na-url-do-webhook"
# Se EVOLUTION_API_URL estiver vazio em development, mensagens sao apenas logadas (provider console).

# IA (Google Gemini). Sem chave, o sistema opera em modo degradado por regras (logado como tal).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Embeddings da base de conhecimento (RAG, pgvector 768 dims). Sem chave, busca textual do Postgres.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=512

# Billing (Stripe). Assinatura obrigatoria no webhook.
STRIPE_WEBHOOK_SECRET=""
# Checkout/portal: chave secreta e price ids (recorrentes) dos planos. Sem chave em development,
# o checkout usa o provider console (nada e cobrado); em production e obrigatoria.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""

# Cron interno (endpoint /api/internal/cron/*). Authorization: Bearer <CRON_SECRET>
CRON_SECRET="troque-por-um-token-aleatorio"

# Google Calendar por clinica (OAuth). Redirect URI: {PUBLIC_API_URL}/api/integrations/google/callback
# Sem credenciais em development, usa provider console (em memoria). Em production, opcional; se definido,
# TOKEN_ENCRYPTION_KEY passa a ser obrigatoria (gere com: uv run python -m app.cli gen-key).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TOKEN_ENCRYPTION_KEY=""
# Push do Google Calendar (events.watch). So tem efeito com PUBLIC_API_URL em https; o polling continua de qualquer forma.
GOOGLE_PUSH_ENABLED=true

# E-mail transacional (SMTP). Sem SMTP_HOST em development, e-mails sao logados no console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Secretar.ia <no-reply@secretar.ia>"

# Super admin inicial (criado/promovido na inicializacao se definido)
SUPER_ADMIN_EMAIL=""

# Contato comercial (botao "Falar com a Julia" do Enterprise e da landing). WhatsApp so digitos com DDI.
SALES_WHATSAPP=""
SALES_CONTACT_NAME="Júlia"
# WhatsApp da conta demo (botao "Converse com a assistente agora" na landing). So digitos com DDI.
DEMO_WHATSAPP=""
# Alertas operacionais (cota em 80% e 100%). Vazio = SUPER_ADMIN_EMAIL.
ALERTS_EMAIL=""

# Rede e operacao
# Confiar em X-Real-IP/X-Forwarded-For (preenchidos pelo BFF e pelo proxy da plataforma). Desligue se o backend
# for exposto diretamente a internet.
TRUST_PROXY_HEADERS=true
# Worker da fila e agendador neste processo. Em varias replicas, deixe true em UMA e false nas demais.
RUN_BACKGROUND_JOBS=true
QUEUE_CONCURRENCY=5
QUEUE_STUCK_MINUTES=10
LOGIN_RATE_LIMIT_PER_MINUTE=10
