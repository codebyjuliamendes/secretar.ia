generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  output               = "../generated_prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum TenantRole {
  OWNER
  MANAGER
  STAFF
}

enum TenantStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum MessageRole {
  USER
  ASSISTANT
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum NotificationType {
  HUMAN_HANDOFF
  APPOINTMENT_REQUESTED
  APPOINTMENT_CANCELED
  BILLING
  SYSTEM
}

// -------------------------------------------------------------
// IDENTIDADE E ACESSO
// -------------------------------------------------------------

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  name            String
  platformRole    PlatformRole @default(USER)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships        Membership[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      TenantRole @default(STAFF)
  createdAt DateTime   @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model VerificationToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, type])
}

// -------------------------------------------------------------
// TENANT (CLINICA) E DADOS DE NEGOCIO
// -------------------------------------------------------------

model Tenant {
  id                String       @id @default(cuid())
  name              String
  whatsapp          String       @unique
  whatsappInstance  String?      @unique
  whatsappConnected Boolean      @default(false)
  prompt            String
  prices            String?
  businessHours     String?
  timezone          String       @default("America/Sao_Paulo")
  status            TenantStatus @default(ACTIVE)
  plan              Plan         @default(FREE)
  subscriptionId    String?      @unique
  customerId        String?
  upsellEnabled     Boolean      @default(false)
  upsellMessage     String?
  upsellDays        Int          @default(150)
  slotMinutes       Int          @default(30)
  features          Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  services          Service[]
  availabilityRules AvailabilityRule[]
  memberships       Membership[]
  patients          Patient[]
  appointments      Appointment[]
  messages          Message[]
  processedMessages ProcessedMessage[]
  executionLogs     ExecutionLog[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  usageCounters     UsageCounter[]
  upsellDispatches  UpsellDispatch[]
  calendarConnection CalendarConnection?
  externalBusy       ExternalBusy[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
}

model Patient {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  name      String?
  notes     String?
  marketingOptOut Boolean @default(false) // pediu para não receber convites de retorno (LGPD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments     Appointment[]
  upsellDispatches UpsellDispatch[]

  @@unique([tenantId, phone])
  @@index([tenantId, createdAt])
}

// Catálogo de serviços da clínica (duração define o tamanho do bloco na agenda)
model Service {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  durationMin Int      @default(60)
  priceCents  Int?
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

// Janelas de atendimento por dia da semana (0 = segunda ... 6 = domingo), em minutos locais desde 00:00
model AvailabilityRule {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([tenantId, weekday])
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serviceId   String?
  serviceRef  Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  service     String
  date        DateTime
  durationMin Int               @default(60)
  endAt       DateTime?
  status      AppointmentStatus @default(PENDING)
  priceCents Int?
  notes      String?
  source     String            @default("AI")
  externalEventId String?     // id do evento no calendário externo (Google)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  upsellDispatches UpsellDispatch[]

  @@index([tenantId, date])
  @@index([tenantId, date, endAt])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([date, status])
}

// -------------------------------------------------------------
// CONVERSA, IDEMPOTENCIA E OBSERVABILIDADE
// -------------------------------------------------------------

model ProcessedMessage {
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId   String
  processedAt DateTime @default(now())

  @@id([tenantId, messageId])
}

// Idempotência de webhooks externos sem tenant (ex.: eventos de billing). id = "<provider>:<eventId>"
model WebhookEvent {
  id         String   @id
  provider   String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model Message {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  @@index([tenantId, phone, createdAt])
}

model ExecutionLog {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        String
  intent       String?
  model        String?
  input        String
  output       String?
  error        String?
  inputTokens  Int?
  outputTokens Int?
  runTimeMs    Int?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Job {
  id         String    @id @default(cuid())
  name       String
  payload    Json
  status     JobStatus @default(PENDING)
  retries    Int       @default(0)
  maxRetries Int       @default(5)
  runAt      DateTime
  lockedAt   DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAt])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  phone     String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([tenantId, readAt, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

model UsageCounter {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period   String
  metric   String
  count    Int    @default(0)

  @@unique([tenantId, period, metric])
}

// Base de conhecimento (RAG). Documentos livres da clínica → trechos com embedding (pgvector, 768 dims).
// `embedding` é Unsupported para o Prisma Client: leitura/escrita via SQL bruto em services/knowledge.py.
model KnowledgeDocument {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  content        String
  chunkCount     Int      @default(0)
  embeddingModel String?
  source         String   @default("text") // text (colado) | pdf | url | file (.txt/.md enviado)
  sourceRef      String?  // nome do arquivo ou URL de origem
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([tenantId, createdAt])
}

model KnowledgeChunk {
  id         String                  @id @default(cuid())
  tenantId   String
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId String
  document   KnowledgeDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position   Int
  content    String
  embedding  Unsupported("vector(768)")?

  @@index([tenantId])
  @@index([documentId])
  // Declarado aqui para o diff schema/migrations fechar; a migration cria este índice como HNSW
  // (vector_cosine_ops), que o Prisma não sabe expressar. Não recrie com `migrate dev` como btree.
  @@index([embedding])
}

// Conexão OAuth da clínica com um calendário externo (Google). Tokens cifrados (Fernet) em repouso.
model CalendarConnection {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             String    @default("google")
  accountEmail         String?
  calendarId           String    @default("primary")
  refreshTokenEnc      String
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  syncEnabled          Boolean   @default(true)
  lastSyncAt           DateTime?
  lastError            String?
  // Leitura (Google → Secretar.ia): token incremental do events.list e carimbo da última leitura.
  syncToken            String?
  lastPullAt           DateTime?
  lastFullPullAt       DateTime?
  // Canal de notificações push (events.watch): id do canal, resourceId do Google, segredo que o Google
  // devolve em X-Goog-Channel-Token e validade (renovado pelo pull quando falta pouco para expirar).
  channelId            String?   @unique
  channelResourceId    String?
  channelToken         String?
  channelExpiresAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Compromisso criado diretamente no calendário externo (não pela Secretar.ia). Bloqueia horários na
// disponibilidade da IA e aparece no calendário da clínica. Espelho do Google: apagado quando o evento some.
model ExternalBusy {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId String
  summary    String?
  startAt    DateTime
  endAt      DateTime
  allDay     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, externalId])
  @@index([tenantId, startAt, endAt])
}

// Rate limit distribuído (janela fixa por bucket). Consistente entre réplicas sem Redis; buckets antigos
// são removidos pela manutenção diária.
model RateLimitBucket {
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([scope, key, windowStart])
  @@index([windowStart])
}

model UpsellDispatch {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([tenantId, createdAt])
}
