generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  output               = "../generated_prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String        @id @default(cuid())
  name           String
  whatsapp       String        @unique
  prompt         String
  prices         String?       
  businessHours  String?      
  subscriptionId String?      // ID da assinatura Stripe/Asaas
  status         String        @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  patients       Patient[]
  appointments   Appointment[]
  logs           Log[]
}

model Patient {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  phone        String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@unique([tenantId, phone])
}

model Appointment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  service     String
  date        DateTime
  status      String   @default("PENDENTE") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  level     String   @default("INFO")
  message   String
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// PILARES DE ENGENHARIA RESILIENTE (SUBSTITUTOS DO N8N)
// -------------------------------------------------------------

// 1. Idempotência: Garante que a mesma mensagem do WhatsApp não seja processada duas vezes
model ProcessedMessage {
  messageId   String   @id
  processedAt DateTime @default(now())
}

// 2. Memória Conversacional: Mantém o contexto de diálogo de cada paciente de forma persistente
model Message {
  id        String   @id @default(cuid())
  phone     String
  tenantId  String
  role      String   // 'user' ou 'assistant'
  content   String
  createdAt DateTime @default(now())

  @@index([phone, tenantId])
}

// 3. Observabilidade: Log estruturado de cada agente de IA
model ExecutionLog {
  id         String   @id @default(cuid())
  tenantId   String
  agent      String   // 'recepcio', 'agenda', 'cancelamento', etc.
  input      String
  output     String?
  error      String?
  runTimeMs  Int?
  createdAt  DateTime @default(now())
}

// 4. Fila de Tarefas (Queue/Retry): Motor de fila persistido no banco com retentativas e backoff
model Job {
  id         String   @id @default(cuid())
  name       String   // 'enviar-whatsapp', 'sincronizar-calendar', etc.
  payload    String   // Conteúdo JSON da tarefa
  status     String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  retries    Int      @default(0)
  maxRetries Int      @default(5)
  runAt      DateTime
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, runAt])
}
